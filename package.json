{
  "name": "sprintmaths-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:webhook": "node --import ./scripts/qa/register.mjs ./scripts/qa/webhook-e2e.test.mjs",
    "test:planning": "node --import ./scripts/qa/register.mjs ./scripts/qa/planning-lead.test.mjs",
    "test:diagnostic": "node --import ./scripts/qa/register.mjs ./scripts/qa/diagnostic-lead.test.mjs && node --import ./scripts/qa/register.mjs ./scripts/qa/diagnostic-2.test.mjs",
    "test:health": "node --import ./scripts/qa/register.mjs ./scripts/qa/health.test.mjs",
    "test": "npm run test:webhook && npm run test:planning && npm run test:diagnostic && npm run test:health && npm run test:email && npm run test:annales && npm run test:tracking",
    "qa:prod": "node scripts/qa/prod-smoke.mjs",
    "test:email": "node --import ./scripts/qa/register.mjs ./scripts/qa/email-sequence.test.mjs",
    "test:annales": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/qa/annales-coverage.test.mjs && node ./scripts/qa/annales-math-review.test.mjs",
    "test:tracking": "node --import ./scripts/qa/register.mjs ./scripts/qa/purchase-tracking.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
